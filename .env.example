# OpenAI-compatible endpoint used by the "llm" translation engine.
# Leave LLM_PROVIDER empty to use LLM_BASE_URL directly.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0

# ElevenLabs voice engine
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_PT=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MAX_CONCURRENCY=2
